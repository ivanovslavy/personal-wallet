# Copy to .env and fill in. .env is gitignored and must stay that way.
# Never paste a key that holds real value into a file in a project directory.

# ── Keys ──────────────────────────────────────────────────────────────────────
# Account 0: deploys the contracts and pays the gas. Needs a balance.
PRIVATE_KEY_DEPLOYER=
# Accounts 1–3: the three owners of the wallet. Each needs a little gas to vote.
PRIVATE_KEY_OWNER1=
PRIVATE_KEY_OWNER2=
PRIVATE_KEY_OWNER3=

# ── RPC endpoints (optional; public fallbacks are built into the config) ──────
GEMBATESTNET_RPC_URL=https://rpc1.gembascan.io
SEPOLIA_RPC_URL=
MAINNET_RPC_URL=
BSC_RPC_URL=
POLYGON_RPC_URL=

# ── Verification ──────────────────────────────────────────────────────────────
# Etherscan API V2: ONE key covers Ethereum, BSC and Polygon.
ETHERSCAN_API_KEY=

# ── Optional ──────────────────────────────────────────────────────────────────
REPORT_GAS=false

# ══ LISTENERS ════════════════════════════════════════════════════════════════
# Everything the listeners need, per network. <NET> is the network name upper-cased:
# GEMBATESTNET, SEPOLIA, MAINNET, BSC, POLYGON — or any name you invent, as long as you
# also give it a <NET>_CHAIN_ID. Nothing about a network lives in the code.

# ── Mail (global; <NET>_MAIL_TO overrides the recipient per network) ──────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

# ── What to watch ────────────────────────────────────────────────────────────
# Required. The deployed wallet address(es), comma-separated.
GEMBATESTNET_WATCH=
SEPOLIA_WATCH=
# Full endpoint list. Free endpoints are tried before keyed ones regardless of order.
GEMBATESTNET_RPC_URLS=
SEPOLIA_RPC_URLS=

# ── Timing ───────────────────────────────────────────────────────────────────
GEMBATESTNET_POLL_MS=20000
SEPOLIA_POLL_MS=90000
GEMBATESTNET_CONFIRMATIONS=2
SEPOLIA_CONFIRMATIONS=4

# ── Alert cadence ────────────────────────────────────────────────────────────
# A mail goes out on a real event or a real FAILURE. A change of the active endpoint is
# routing between call classes, not a fault, so it is counted and not mailed — mailing it
# produced 48 messages in one day that all said nothing was wrong.
#   ANOMALY_MAIL_MS  how often a failure digest may go out   (default 1800000 = 30 min)
#   SUMMARY_MS       one heartbeat per period, 0 = none      (default 86400000 = 24 h)
#   MAIL_ON_SWITCH   true = mail every endpoint change       (default false)
GEMBATESTNET_ANOMALY_MAIL_MS=1800000
GEMBATESTNET_SUMMARY_MS=86400000
GEMBATESTNET_MAIL_ON_SWITCH=false
SEPOLIA_ANOMALY_MAIL_MS=1800000
SEPOLIA_SUMMARY_MS=86400000
SEPOLIA_MAIL_ON_SWITCH=false

# Where the position is kept. Default: ./.listener-state/<network>.json
STATE_DIR=
